{
  "id": "bolt",
  "displayName": "bolt",
  "icon": "✉️",
  "authUrl": "imap://",
  "search": {
    "from": [
      "invoice@bolt.com"
    ],
    "subjectKeywords": [
      "rechnung, invoice"
    ],
    "folders": [
      "INBOX",
      "[Gmail]/All Mail"
    ]
  },
  "extraction": {
    "mode": "attachment_or_html",
    "attachmentRegex": "\\.pdf$",
    "htmlCssFixes": "@media print { body { font-size: 11pt; } }"
  },
  "parser": {
    "currency": "EUR",
    "regex": {
      "orderId": "",
      "date": "",
      "brutto": "",
      "ust": "",
      "seller": ""
    },
    "taxRate": "19%",
    "aiFallback": false
  }
}